# HTTP port for local development; Railway supplies PORT automatically.
PORT=3000
# Runtime mode used by Express and npm.
NODE_ENV=production
# Optional comma-separated browser-origin allowlist; empty preserves current open CORS behavior.
CORS_ORIGINS=
# Optional token required in the x-trigger-token header for POST /api/scrape/trigger.
TRIGGER_TOKEN=
# Minimum gap between manual scrape triggers, in milliseconds.
TRIGGER_COOLDOWN_MS=60000

# Relative API path baked into the frontend build; leave as /api when one service serves both UI and API.
VITE_API_URL=/api

# Directory for prices.json and progress.json; set to the Railway Volume mount path (for example /data).
DATA_DIR=./backend/data
# Optional direct path to prices.json; overrides DATA_DIR for API reads only.
# PRICES_FILE=
# Cron expression for automatic scrapes.
SCRAPER_CRON=0 * * * *
# Number of locations scraped in parallel.
SCRAPER_CONCURRENCY=3
# Set true to run the dashboard API without its in-process scraper worker.
# DISABLE_SCRAPER=true

# Maximum allowed whole-job duration, in milliseconds.
SCRAPER_JOB_TIMEOUT_MS=2700000
# Per-location, movie, and region-lock ceilings, in milliseconds.
LOCATION_TIMEOUT_MS=900000
MOVIE_TIMEOUT_MS=180000
REGION_LOCK_TIMEOUT_MS=120000
# Playwright navigation, selector, response, and post-load wait limits, in milliseconds.
NAV_TIMEOUT_MS=30000
SELECTOR_TIMEOUT_MS=15000
RESPONSE_TIMEOUT_MS=8000
SETTLE_MS=1500
# Maximum discovery-page scroll passes.
MAX_DISCOVERY_SCROLLS=8
# Random delay range before each location starts, in milliseconds.
SCRAPER_MIN_DELAY_MS=1000
SCRAPER_MAX_DELAY_MS=3000
# Retry failed or empty locations once; set false to disable.
SCRAPER_RETRY_EMPTY=true

# Price rows older than this many days are pruned.
PRICE_RETENTION_DAYS=30
# Maximum changed-price history points retained per row.
MAX_HISTORY_POINTS=100
# Delay before buffered price writes are flushed, in milliseconds.
FLUSH_INTERVAL_MS=15000
# Number of future dates displayed and scraped.
FORECAST_DAYS=4
# Timezone used for dashboard dates and scraping display.
TZ_DISPLAY=Asia/Kolkata
