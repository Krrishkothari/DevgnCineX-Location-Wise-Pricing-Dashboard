# ── Server ────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# Comma-separated allowlist. Empty means allow every origin (the previous
# behaviour) — set this in production.
CORS_ORIGINS=

# Optional shared secret for POST /api/scrape/trigger. When set, callers must
# send it as the `x-trigger-token` header.
TRIGGER_TOKEN=
# Minimum gap between manual triggers, in milliseconds.
TRIGGER_COOLDOWN_MS=60000

# ── Redis (BullMQ) ────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── Frontend (build time) ─────────────────────────────────────────────────
# Relative by default so the built app works on whatever host serves it.
# The old value hardcoded localhost, which shipped in any production build.
VITE_API_URL=/api

# ── Scraper ───────────────────────────────────────────────────────────────
SCRAPER_CRON=0 * * * *

# How many locations run in parallel. Each drives up to 3 movie pages, so the
# real tab count is roughly 3x this. On a small container lower is faster —
# too many concurrent Chromium tabs just thrash the CPU.
SCRAPER_CONCURRENCY=3

# Abandon a whole run after this long. Keep it comfortably under the cron
# interval so a slow run can never overlap the next one.
SCRAPER_JOB_TIMEOUT_MS=2700000
# BullMQ job lock; also kept under the cron interval.
SCRAPER_LOCK_DURATION_MS=3000000

# Per-unit ceilings, so one hung page can't consume the whole run.
LOCATION_TIMEOUT_MS=900000
MOVIE_TIMEOUT_MS=180000
REGION_LOCK_TIMEOUT_MS=120000

# Playwright waits.
NAV_TIMEOUT_MS=30000
SELECTOR_TIMEOUT_MS=15000
RESPONSE_TIMEOUT_MS=8000
SETTLE_MS=1500
MAX_DISCOVERY_SCROLLS=8

# Politeness delay before starting each location.
SCRAPER_MIN_DELAY_MS=1000
SCRAPER_MAX_DELAY_MS=3000

# ── Storage ───────────────────────────────────────────────────────────────
# Rows whose show date is older than this are dropped, so prices.json stops
# growing without bound.
PRICE_RETENTION_DAYS=30
# Cap on recorded price changes per row.
MAX_HISTORY_POINTS=100
# How long writes are batched before hitting disk.
FLUSH_INTERVAL_MS=15000

# Set on the backend to run it API-only (e.g. when the scraper runs in its own
# container via scraper/scheduler.js).
# DISABLE_SCRAPER=true
